{
  "name": "aurigin-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-transform-types server/index.ts",
    "build": "tsc --noEmit && vite build --configLoader native",
    "start": "node --experimental-transform-types server/index.ts",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "release:check": "pnpm build && pnpm test"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5",
    "luxon": "3.7.2",
    "pdf-lib": "1.17.1",
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/luxon": "3.7.1",
    "typescript": "5.9.2",
    "tsx": "4.20.5",
    "vite": "7.1.4"
  }
}
